@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap');

:root {
  --bg: #0e0f11;
  --surface: #16181c;
  --border: #272b32;
  --text: #eef0f4;
  --text-muted: #7a8090;
  --accent: #4ade80;
  --accent-dark: #22c55e;
  --accent-glow: rgba(74, 222, 128, 0.15);
  --shadow: rgba(0, 0, 0, 0.4);
  --img-bg: #1c1f25;
  --chip-bg: #1c1f25;
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body, #root {
  height: 100%;
}

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── Header ── */
.app-header {
  padding: 4rem 2rem 3rem;
  text-align: center;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, #0a1a0e 0%, var(--bg) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.header-tag {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--accent);
  background: var(--accent-glow);
  padding: 0.3rem 0.9rem;
  border-radius: 999px;
  border: 1px solid rgba(74, 222, 128, 0.25);
}

.app-title {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.2rem, 6vw, 3.8rem);
  font-weight: 800;
  line-height: 1.1;
  color: var(--text);
  letter-spacing: -0.03em;
}

.accent-text {
  color: var(--accent);
}

.app-subtitle {
  font-size: 1rem;
  color: var(--text-muted);
  max-width: 440px;
  margin-bottom: 0.5rem;
}

/* ── Main ── */
.app-main {
  flex: 1;
  padding: 2.5rem 2rem 4rem;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
}

.results-count {
  font-size: 0.8rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 1.25rem;
}

/* ── States ── */
.state-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 5rem 1rem;
  gap: 1rem;
  text-align: center;
}

.state-icon {
  font-size: 3rem;
  line-height: 1;
}

.state-msg {
  color: var(--text-muted);
  font-size: 1rem;
  max-width: 340px;
}

/* ── Spinner ── */
.spinner {
  width: 44px;
  height: 44px;
  border: 3px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── Responsive ── */
@media (max-width: 480px) {
  .app-header {
    padding: 2.5rem 1.25rem 2rem;
  }
  .app-main {
    padding: 1.5rem 1.25rem 3rem;
  }
}
